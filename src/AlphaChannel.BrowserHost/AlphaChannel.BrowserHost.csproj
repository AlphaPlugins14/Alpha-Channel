<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Keep the Chromium payload separate from the plugin build directory.
         AlphaChannel.Plugin copies it in only after its own output cleanup. -->
    <OutputPath>bin\BrowserPayload\$(Configuration)\</OutputPath>
    <CefSharpBuildAction>Default</CefSharpBuildAction>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AlphaChannel.BrowserShared/EasyListBlocker.cs" Link="EasyListBlocker.cs" />
    <Compile Include="../AlphaChannel.BrowserShared/NavigationGuard.cs" Link="NavigationGuard.cs" />
    <Compile Include="../AlphaChannel.BrowserShared/YouTubeAccountLookup.cs" Link="YouTubeAccountLookup.cs" />
    <EmbeddedResource Include="../AlphaChannel.BrowserShared/preapproved-redirect-hosts.txt" LogicalName="AlphaChannel.PreapprovedRedirectHosts.txt" />
    <None Include="../AlphaChannel.BrowserShared/easylist.txt" Link="easylist.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../AlphaChannel.BrowserShared/NOTICE.txt" Link="EasyList-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="150.0.110" />
  </ItemGroup>
</Project>
