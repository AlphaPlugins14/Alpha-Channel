<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\ProbePayload\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AlphaChannel.Plugin/SpotifyLinks.cs" Link="SpotifyLinks.cs" />
    <Compile Include="../AlphaChannel.Plugin/SpotifyLinkMetadata.cs" Link="SpotifyLinkMetadata.cs" />
    <Compile Include="../AlphaChannel.Plugin/SpotifyAutomationRules.cs" Link="SpotifyAutomationRules.cs" />
  </ItemGroup>
</Project>
