<Project>
  <!-- Build-time input only. The private file lives outside every project and
       is ignored by Git; environment/command-line settings can override it. -->
  <PropertyGroup>
    <SixLaborsLicenseFile Condition="'$(SixLaborsLicenseFile)' == '' and Exists('$(MSBuildThisFileDirectory).local/licenses/sixlabors.lic')">$(MSBuildThisFileDirectory).local/licenses/sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>
  <!-- NuGet's advisory feed still includes the patched v3 backport in these
       affected ranges. Apply these exceptions only to an exact 3.2.0 pin;
       new versions/advisories must be reviewed normally. Evidence and removal
       criteria: docs/imagesharp-audit-exceptions.md. Auditing stays enabled. -->
  <ItemGroup>
    <_PatchedImageSharpReference Include="@(PackageReference->WithMetadataValue('Identity', 'SixLabors.ImageSharp')->WithMetadataValue('Version', '[3.2.0]'))" />
  </ItemGroup>
  <ItemGroup Condition="'@(_PatchedImageSharpReference)' != ''">
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
  <ItemGroup>
    <None Update="**/*.lic" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Pack="false" />
    <Content Remove="**/*.lic" />
    <EmbeddedResource Remove="**/*.lic" />
  </ItemGroup>
</Project>
